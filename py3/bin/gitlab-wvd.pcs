#!/usr/bin/env python

""" #+begin_org
* ~[Summary]~ :: A =PlantedCmndService= for gitlab.here NGINX virtual-host (capWebVd) --- fronts gitlab-workhorse
#+end_org """

from bisos.b import cs
import collections

from bisos.csSeed import seedsLib

from bisos.webCap import capWebVd_seed  # noqa: F401  # _atExit_

from bisos.webCap import capWebVd_seedInfo
from bisos.gitlab.gitlabInfo import gitlabInfo

serverName = gitlabInfo.fqdn
# gitlab-workhorse listens on gitlabInfo.workhorseAddr (TCP loopback, set in gitlab.rb); the bundled
# nginx is disabled, so BISOS's nginx is GitLab's only front.
proxyIp = gitlabInfo.listenIp
proxyPort = gitlabInfo.portNu

def wvdConfigFunc() -> str:
    """A reverse proxy to workhorse, after GitLab's "non-bundled web server" configuration.

    Untested (base only). client_max_body_size 0: git pushes and uploads are limited by GitLab
    itself; proxy_read_timeout for long git operations; the Upgrade headers for ActionCable
    (/-/cable, live updates).
    """
    return f"""\
server {{
    listen 80;
    server_name {serverName};
    server_tokens off;
    client_max_body_size 0;

    location / {{
        proxy_pass http://{proxyIp}:{proxyPort};
        proxy_http_version 1.1;
        proxy_read_timeout 300;
        proxy_connect_timeout 300;
        proxy_redirect off;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $http_connection;
    }}
}}
"""

capWebVd_seedInfo.setup(
    serverName=serverName,
    proxyPort=proxyPort,
    wvdConfigFunc=wvdConfigFunc,
)

from bisos.csSeed import csCmndsList_seedInfo
csCmnd = csCmndsList_seedInfo.csCmnd

csCmndsList = [
    csCmnd("configFileStdout", pars={'cls': 'configFile_nginxVd'},),
    csCmnd("configFileUpdate", pars={'cls': 'configFile_nginxVd', 'runAs': 'root'},),
    csCmnd("webVd_enable",),
    csCmnd("webVd_verify",),
    csCmnd("webVd_resolve",),
    csCmnd("webVd_fqdnPing",),
]

csCmndsList_seedInfo.setup(
    csCmndsList=csCmndsList,
)
